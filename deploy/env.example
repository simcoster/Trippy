# Copy to /opt/trippy/.env on the VM. Never commit the real file.

POSTGRES_USER=trippy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trippy
DATABASE_URL=postgresql://trippy:change-me@db:5432/trippy

NEBIUS_API_KEY=
GOOGLE_API_KEY=

# Optional: evening dump also copies to Object Storage (see docs/deploy.md).
# JOBS_URL is set by docker-compose.prod.yml (http://jobs:8080). Do not publish 8080.
# TRIPPY_S3_BUCKET=trippy-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
