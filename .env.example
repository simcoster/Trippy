# Names only. Copy to `.env` on the VM (`chmod 600`). Never commit the copy.

# Postgres (compose.prod interpolates this into DATABASE_URL). Use alphanumerics.
POSTGRES_PASSWORD=

# Token Factory (chat + embeddings). Not the cloud IAM key.
NEBIUS_API_KEY=

# Google Place Details / Text Search. Needed for scrape reviews and place-ids.
GOOGLE_API_KEY=

# Named-tunnel token from Cloudflare Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Streamlit hides traces / MCP / heavy-path controls when set.
TRIPPY_PUBLIC_UI=1

# LangSmith: LangGraph tester turns (Streamlit). Tracing is turned on in
# that process when the key is set. Do not also set LANGSMITH_TRACING=true
# here — scrape jobs share this file and would send ingest LLM calls.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trippy

# Object storage (scripts/cloud/backup.sh, just backup). Public schema only.
# Required on the VM — backup.yml fails without an upload. Uncomment and fill.
# Laptop: optional (just backup stays on disk if unset).
# BACKUP_S3_BUCKET=trippy-backups
# AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-north1
