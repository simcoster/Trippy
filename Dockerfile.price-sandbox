FROM python:3.14-slim

WORKDIR /app

RUN useradd --system --uid 10001 --no-create-home sandbox \
    && mkdir -p /app/source \
    && printf '' > /app/source/__init__.py

COPY source/price_sandbox /app/source/price_sandbox
# Loader talks to Postgres; the jail image must not ship it.
RUN rm -f /app/source/price_sandbox/load.py

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER sandbox

EXPOSE 8503

CMD ["python", "-m", "source.price_sandbox"]
